# Copy to .env and fill in real values. Never commit .env.

# Where the SQLite file lives (relative to prisma/).
DATABASE_URL="file:./dev.db"

# Signing key for the session cookie — a random string of 32+ characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Optional: real email delivery (flow design rule 15). With all four set,
# notifications are sent over SMTP; without them the mail is logged as
# "[email] to <address>: <subject>" on the dev console instead. A mail
# failure never blocks a leave action.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=Budiman HRMS <hrms@budiman.com>
